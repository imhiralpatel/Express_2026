<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
</head>
<body>
    <form action="/ui/update/<%= student[0].ID %>" method="post">
            <input type="text" placeholder="Enter Name" name="name" value="<%= student[0].sname %>" />
            <br>
            <br>
            <input type="text" placeholder="Enter Age" name="age" value="<%= student[0].sage %>" />
            <br>
            <br>
            <input type="text" placeholder="Enter Email" name="email" value="<%= student[0].semail %>" />
            <br>
            <br>
            <button>Update Student</button>
        </form>

        <br>
        <a href="/ui" title="Back to student list">Back to Record</a>
</body>
</html>