<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>
</head>
<body>
    <h1>
        User Page
    </h1>
    <ul>
        <% for(let i=0; i<uname.length; i++) { %>
        <li>
            <%= uname[i] %>
        </li>
    <% } %>
    </ul>

    <% if(isLogin){ %>
        <h1>
            User is Login
        </h1>
    <% }
    else
    {
     %>
        <h1>
            User is not Login
        </h1>
    <% } %>
</body>
</html>