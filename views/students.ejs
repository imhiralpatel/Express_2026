<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data</title>
</head>
<body>
    <h1>
        Data feching...
    </h1>

    <table border="1">
        <tr>
            <td>
                Name
            </td>
            <td>
                Age
            </td>
            <td>
                Email
            </td>
        </tr>
        <% student.forEach(stud=>{ %>
        <tr>
            <td>
                <%= stud.sname %>
            </td>
            <td>
                <%= stud.sage %>
            </td>
            <td>
                <%= stud.semail %>
            </td>
        </tr>
        <% }) %>
    </table>
</body>
</html>